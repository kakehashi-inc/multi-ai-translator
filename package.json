{
  "name": "multi-ai-translator",
  "version": "0.1.0",
  "description": "Browser extension for translating web pages using multiple AI providers",
  "type": "module",
  "scripts": {
    "sync:version": "node scripts/sync-manifest-version.js",
    "sync:version:chrome": "node scripts/sync-manifest-version.js chrome",
    "sync:version:firefox": "node scripts/sync-manifest-version.js firefox",
    "tokens:generate": "node scripts/generate-scss-tokens.js",
    "dev": "yarn tokens:generate && vite build --config vite.config.ts --watch",
    "dev:firefox": "yarn tokens:generate && vite build --config vite.firefox.config.ts --watch",
    "build": "yarn build:chrome && yarn build:firefox",
    "build:chrome": "yarn tokens:generate && yarn sync:version:chrome && vite build --config vite.config.ts",
    "build:firefox": "yarn tokens:generate && yarn sync:version:firefox && vite build --config vite.firefox.config.ts",
    "clean": "gulp clean",
    "lint": "gulp lint",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,json}\"",
    "package": "node scripts/package.js",
    "release": "yarn clean && yarn format && yarn lint && yarn build && yarn package"
  },
  "keywords": [
    "chrome-extension",
    "edge-extension",
    "firefox-addon",
    "translation",
    "ai",
    "llm",
    "openai",
    "anthropic",
    "gemini",
    "ollama"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.6.1",
    "@eslint/js": "^10.0.1",
    "@prantlf/gulp-jsonlint": "^3.0.1",
    "@types/chrome": "^0.1.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/webextension-polyfill": "^0.12.5",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitejs/plugin-react": "^6.0.2",
    "archiver": "^7.0.1",
    "cross-env": "^10.1.0",
    "del": "^8.0.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "gulp": "^5.0.1",
    "gulp-eslint-new": "^2.6.2",
    "gulp-stylelint-esm": "^3.0.0",
    "prettier": "^3.8.4",
    "sass-embedded": "^1.100.0",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vite-plugin-static-copy": "^4.1.1",
    "webextension-polyfill": "^0.12.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@google/genai": "^2.8.0",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^9.1.1",
    "ollama": "^0.6.3",
    "openai": "^6.42.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
